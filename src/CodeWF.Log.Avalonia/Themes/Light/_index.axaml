<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CodeWFLogViewTimestampForeground">#8C8C8C</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewContentForeground">#262626</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewTraceForeground">#1890FF</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewInformationForeground">#52C41A</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewWarningForeground">#FAAD14</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewErrorForeground">#FF4D4F</SolidColorBrush>
</ResourceDictionary>
