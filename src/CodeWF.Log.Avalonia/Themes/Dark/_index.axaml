<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CodeWFLogViewTimestampForeground">#8EA0B8</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewContentForeground">#D7E2F0</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewTraceForeground">#69B7FF</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewInformationForeground">#69D38A</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewWarningForeground">#F6C85F</SolidColorBrush>
    <SolidColorBrush x:Key="CodeWFLogViewErrorForeground">#FF7B7D</SolidColorBrush>
</ResourceDictionary>
